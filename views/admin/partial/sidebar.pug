aside(class="w-[260px] bg-n-800 text-white fixed top-0 left-0 h-full z-50 flex flex-col")
  .p-5.text-lg.font-bold.bg-black.bg-opacity-10.flex.items-center.gap-3
    a(href="/admin/dashboard" class="text-white flex items-center gap-3 no-underline")
      i.fa-solid.fa-paw
      span PetCare Admin
  
  ul(class="list-none py-4 flex flex-col gap-1")
    li.sidebar__item
      a(href="/admin/dashboard" class=`flex items-center gap-3 px-5 py-3 text-n-200 no-underline transition-colors duration-200 hover:bg-n-500 hover:text-white ${path === '/dashboard' ? 'bg-n-500 text-white font-semibold' : ''}`)
        i.fa-solid.fa-chart-pie
        span Tổng quan

    li.sidebar__item
      a(href="/admin/services" class=`flex items-center gap-3 px-5 py-3 text-n-200 no-underline transition-colors duration-200 hover:bg-n-500 hover:text-white ${path === '/services' ? 'bg-n-500 text-white font-semibold' : ''}`)
        i.fa-solid.fa-notes-medical
        span Quản lý Dịch vụ

    li.sidebar__item
      a(href="/admin/pets" class=`flex items-center gap-3 px-5 py-3 text-n-200 no-underline transition-colors duration-200 hover:bg-n-500 hover:text-white ${path === '/pets' ? 'bg-n-500 text-white font-semibold' : ''}`)
        i.fa-solid.fa-dog
        span Thú cưng & Khách hàng

    li.sidebar__item
      a(href="/admin/settings" class=`flex items-center gap-3 px-5 py-3 text-n-200 no-underline transition-colors duration-200 hover:bg-n-500 hover:text-white ${path === '/settings' ? 'bg-n-500 text-white font-semibold' : ''}`)
        i.fa-solid.fa-gear
        span Cài đặt chung