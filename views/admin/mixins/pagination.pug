mixin pagination(pagination)
  if pagination
    - var current = pagination.currentPage || 1
    - var total = pagination.totalPage || 1

    div(pagination class="mt-5 flex items-center justify-center gap-4 font-inter text-base text-p-700")
      //- Nút lùi trang
      button(
        type="button"
        page=current > 1 ? current - 1 : 1
        class=`hover:bg-n-200 rounded-full w-9 h-9 flex items-center justify-center cursor-pointer transition-all ${current === 1 ? 'opacity-30 cursor-not-allowed pointer-events-none' : ''}`
      )
        i(class="fa-solid fa-chevron-left")

      //- Hiển thị trang hiện tại
      span(class="text-sm font-semibold px-2") #{current} / #{total}

      //- Nút tiến trang
      button(
        type="button"
        page=current < total ? current + 1 : total
        class=`hover:bg-n-200 rounded-full w-9 h-9 flex items-center justify-center cursor-pointer transition-all ${current === total ? 'opacity-30 cursor-not-allowed pointer-events-none' : ''}`
      )
        i(class="fa-solid fa-chevron-right")