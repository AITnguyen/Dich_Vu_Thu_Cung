mixin alert-success(time)
  - if (messages.success)
    div(
      class="mb-4 p-4 text-sm text-green-700 bg-green-100 border border-green-300 rounded-lg flex items-center justify-between shadow-sm transition-all duration-300"
      role="alert"
    )
      div(class="flex items-center gap-2")
        span(class="font-semibold") Thành công:
        span #{messages.success}
      button(
        type="button"
        class="text-green-700 hover:text-green-900 font-bold text-lg leading-none cursor-pointer"
        onclick="this.parentElement.style.display='none';"
      ) &times;