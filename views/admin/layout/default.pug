doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title #{pageTitle || "Quản Trị Thú Cưng"}
    link(rel="stylesheet", href="/css/output.css")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
  
  body(style="margin: 0; padding: 0; background-color: #fffaf5; font-family: 'Inter', sans-serif;")
    
    include ../partial/sidebar.pug

    div(style="margin-left: 250px; min-height: 100vh; display: flex; flex-direction: column;")
      
      include ../partial/header.pug
      
      main(style="padding: 32px; flex: 1;")
        block main