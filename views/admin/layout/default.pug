doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title #{pageTitle || "Quản Trị Thú Cưng"}
    link(rel="stylesheet", href="/css/output.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
  
  body(class="bg-n-50 font-inter text-n-800")
    // Thanh Sidebar cố định bên trái
    include ../partial/sidebar.pug

    // Vùng chứa nội dung chính bên phải (đẩy lề trái 260px)
    div(class="ml-[260px] flex flex-col min-h-screen")
      include ../partial/header.pug
      
      main(class="p-8 flex-1")
        block main