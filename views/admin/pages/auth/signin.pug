extends ../../../client/layout/auth.pug

block main
  div(class="min-h-screen flex items-center justify-center bg-gray-100 p-4")
    div(class="max-w-md w-full bg-white rounded-2xl shadow-xl p-8")
      span(class="text-2xl font-extrabold text-[#4A3525]") PetCare
      h1(class="text-2xl font-bold text-gray-900 mt-6 mb-2") Đăng nhập quản trị viên
      p(class="text-sm text-gray-600 mb-6") Dùng tài khoản nhân viên đã được cấp quyền quản trị.

      if errorMessage
        div(class="mb-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700" role="alert")= errorMessage

      form(action="/admin/auth/signin" method="POST" class="flex flex-col gap-4")
        div(class="flex flex-col gap-1.5")
          label(for="email" class="text-sm font-semibold text-gray-700") Email
          input(type="email" id="email" name="email" required autocomplete="username" class="w-full px-4 py-3 rounded-xl border border-gray-300")
        div(class="flex flex-col gap-1.5")
          label(for="password" class="text-sm font-semibold text-gray-700") Mật khẩu
          input(type="password" id="password" name="password" required autocomplete="current-password" class="w-full px-4 py-3 rounded-xl border border-gray-300")
        button(type="submit" class="w-full py-3 bg-[#4A3525] text-white font-bold rounded-xl cursor-pointer") ĐĂNG NHẬP

      a(href="/admin/auth/forgot-password" class="block mt-4 text-center text-sm text-amber-800 hover:underline") Quên mật khẩu?
      a(href="/" class="block mt-3 text-center text-sm text-gray-600 hover:underline") Về trang PetCare