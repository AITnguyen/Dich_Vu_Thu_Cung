extends ../../layout/default.pug

block main
  .container.mx-auto.px-4.py-12
    .max-w-md.mx-auto.bg-white.p-8.border.border-n-200.rounded-2xl.shadow-md
      h1(class="text-2xl font-bold text-n-800 mb-6 text-center") Đăng Ký Tài Khoản

      form(action="/auth/signup", method="POST" class="flex flex-col gap-4")
        .flex.flex-col.gap-1
          label(for="fullName" class="text-sm font-semibold text-n-700") Họ và tên
          input(
            type="text" 
            id="fullName" 
            name="fullName" 
            required 
            placeholder="Nhập họ và tên..." 
            class="px-4 py-2 border border-n-200 rounded-xl focus:outline-none focus:border-p-500"
          )

        .flex.flex-col.gap-1
          label(for="email" class="text-sm font-semibold text-n-700") Email hoặc Số điện thoại
          input(
            type="text" 
            id="email" 
            name="email" 
            required 
            placeholder="Nhập email của bạn..." 
            class="px-4 py-2 border border-n-200 rounded-xl focus:outline-none focus:border-p-500"
          )

        .flex.flex-col.gap-1
          label(for="password" class="text-sm font-semibold text-n-700") Mật khẩu
          input(
            type="password" 
            id="password" 
            name="password" 
            required 
            placeholder="••••••••" 
            class="px-4 py-2 border border-n-200 rounded-xl focus:outline-none focus:border-p-500"
          )

        button(type="submit" class="mt-4 py-2.5 bg-p-500 text-white font-semibold rounded-xl hover:bg-p-600 transition-colors cursor-pointer")
          | Đăng Ký

      .text-center.mt-4
        p(class="text-sm text-n-500") Đã có tài khoản? 
          a(href="/auth/signin" class="text-p-500 font-semibold hover:underline") Đăng nhập ngay