extends ../../layout/default.pug

block main
  h3(class="text-2xl font-bold mb-6 font-inter text-p-900") Chỉnh sửa Dịch vụ Thú Cưng

  div(class="bg-white rounded-lg shadow p-6 max-w-3xl")
    form(
      action=`/admin/services/edit/${service.id}?_method=PATCH`
      method="POST"
      enctype="multipart/form-data"
      class="space-y-4"
    )
      div
        label(class="block text-sm font-semibold text-n-700 mb-1" for="title") Tên dịch vụ
        input(
          type="text"
          id="title"
          name="title"
          value=service.title
          required
          class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-p-500"
          placeholder="Nhập tên dịch vụ..."
        )

      div
        label(class="block text-sm font-semibold text-n-700 mb-1" for="price") Giá dịch vụ (VNĐ)
        input(
          type="number"
          id="price"
          name="price"
          value=service.price
          required
          class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-p-500"
          placeholder="Nhập giá..."
        )

      div
        label(class="block text-sm font-semibold text-n-700 mb-1" for="thumbnail") Hình ảnh dịch vụ
        div(class="mb-2")
          img(src=service.thumbnail || "/image/thumbnail.jpg", alt="Preview", style="width: 80px; height: 80px; object-fit: cover;" class="rounded-lg border border-n-200")
        
        input(type="hidden" name="oldThumbnail" value=service.thumbnail)
        
        input(
          type="file"
          id="thumbnail"
          name="thumbnail"
          accept="image/*"
          class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-p-500 bg-white"
        )

      div
        label(class="block text-sm font-semibold text-n-700 mb-1") Trạng thái
        div(class="flex items-center gap-4 mt-2")
          label(class="flex items-center gap-2 cursor-pointer")
            input(type="radio" name="status" value="active" checked=(service.status === 'active'))
            span Hoạt động
          label(class="flex items-center gap-2 cursor-pointer")
            input(type="radio" name="status" value="inactive" checked=(service.status === 'inactive'))
            span Dừng hoạt động

      div
        label(class="block text-sm font-semibold text-n-700 mb-1" for="description") Mô tả dịch vụ
        textarea(
          id="description"
          name="description"
          rows="4"
          class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-p-500"
          placeholder="Nhập mô tả..."
        ) #{service.description}

      div(class="flex justify-end items-center gap-3 pt-4 w-full")
        a(
          href="/admin/services"
          class="px-5 py-2 bg-n-200 hover:bg-n-300 text-n-800 rounded-lg font-semibold transition-all no-underline text-center"
        ) Hủy
        button(
          type="submit"
          class="px-5 py-2 btn-2 no-underline cursor-pointer text-center"
        ) Cập nhật