extends ../../layout/default.pug
include ../../mixins/filter-status.pug
include ../../mixins/pagination.pug

block main
  //- Tiêu đề trang
  .mb-6
    h1.text-2xl.font-bold.text-n-800 Quản lý Phòng Lưu Trú

  //- Hàng chứa Bộ lọc trạng thái (bên trái) và Nút Thêm mới (bên phải)
  .flex.justify-between.items-center.mb-6
    .flex.items-center.gap-2
      +filterStatus(filterStatus)
    
    a(href="/admin/rooms/create", class="btn-2 no-underline flex items-center gap-2")
      i.fa-solid.fa-plus
      span Thêm Phòng Mới

  //- Bảng hiển thị danh sách phòng lưu trú
  .card.bg-white.rounded-xl.shadow-sm.border.border-n-200.overflow-hidden
    table.table-admin
      thead
        tr
          th STT
          th Hình ảnh
          th Tên phòng
          th Sức chứa
          th Giá ngày
          th Trạng thái
          th Hành động
      tbody
        if rooms && rooms.length > 0
          each room, index in rooms
            - var currentPage = pagination.currentPage || 1
            - var limit = 5
            tr
              td.font-semibold #{(currentPage - 1) * limit + index + 1}
              td 
                img(src=room.thumbnail || "/image/thumbnail.jpg", alt="Room", style="width: 60px; height: 60px; object-fit: cover;" class="rounded-lg border border-n-200")
              td.font-semibold.text-n-800 #{room.name}
              td.text-n-600 #{room.capacity} khách
              td.text-p-500.font-semibold #{room.price}
              td(style="white-space: nowrap;")
                if room.status === 'active'
                  span(style="background-color: #16a34a; color: white;" class="px-3 py-2 rounded-lg text-xs font-semibold inline-block") Hoạt động
                else
                  span(style="background-color: #d14b43; color: white;" class="px-3 py-2 rounded-lg text-xs font-semibold inline-block") Dừng hoạt động
              td(style="white-space: nowrap;")
                .flex.items-center.gap-2
                  a(href=`/admin/rooms/edit/${room.id}`, class="px-3 py-1.5 bg-p-100 text-p-700 rounded-lg text-xs font-semibold hover:bg-p-500 hover:text-white transition-colors no-underline") Sửa
                  button(class="px-3 py-1.5 bg-red-100 text-danger-500 rounded-lg text-xs font-semibold hover:bg-p-500 hover:text-white transition-colors cursor-pointer") Xóa
        else
          tr
            td(colspan="7" class="text-center py-8 text-n-500") Không tìm thấy phòng lưu trú nào.

  //- Gọi Mixin Phân Trang ở phía dưới bảng
  +pagination(pagination)