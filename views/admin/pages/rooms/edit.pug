extends ../../layout/default.pug

block main
  h3(class="text-2xl font-bold mb-6 font-inter text-p-900")
    | Chỉnh sửa phòng lưu trú

  if successMessage
    div(class="mb-4 p-4 text-sm text-green-700 bg-green-100 border border-green-300 rounded-lg")
      = successMessage

  if errorMessage
    div(class="mb-4 p-4 text-sm text-red-700 bg-red-100 border border-red-300 rounded-lg")
      = errorMessage

  div(class="bg-white rounded-lg shadow p-6 max-w-3xl")
    form(
      action=`/admin/rooms/edit/${room.PHONG_ID}`
      method="POST"
      enctype="multipart/form-data"
      class="space-y-4"
    )
      div
        label(class="block text-sm font-semibold text-n-700 mb-1" for="thumbnail")
          | Ảnh phòng
        input(
          type="file"
          id="thumbnail"
          name="thumbnail"
          accept="image/*"
          preview-image
          class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-p-500"
        )
        if room.PHONG_ANH
          img(
            src=room.PHONG_ANH
            alt="Ảnh phòng hiện tại"
            class="mt-3 w-28 h-28 object-cover rounded-lg border"
          )
        img(
          src=""
          alt="Xem trước ảnh mới"
          preview
          class="hidden mt-3 w-28 h-28 object-cover rounded-lg border"
        )

      div
        label(class="block text-sm font-semibold text-n-700 mb-1" for="title")
          | Tên phòng
        input(
          type="text"
          id="title"
          name="title"
          value=room.PHONG_TEN
          maxlength="100"
          required
          class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-p-500"
        )

      div
        label(class="block text-sm font-semibold text-n-700 mb-1" for="capacity")
          | Sức chứa (thú cưng)
        input(
          type="number"
          id="capacity"
          name="capacity"
          value=room.PHONG_SL
          min="1"
          step="1"
          required
          class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-p-500"
        )

      div
        label(class="block text-sm font-semibold text-n-700 mb-1" for="price")
          | Giá mỗi ngày (VNĐ)
        input(
          type="number"
          id="price"
          name="price"
          value=room.PHONG_GIANGAY
          min="0"
          step="1000"
          required
          class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-p-500"
        )

      div
        label(class="block text-sm font-semibold text-n-700 mb-1")
          | Trạng thái
        div(class="flex items-center gap-4 mt-2")
          label(class="flex items-center gap-2 cursor-pointer")
            input(
              type="radio"
              name="status"
              value="active"
              checked=(room.PHONG_TRANGTHAI === "active")
            )
            span Hoạt động
          label(class="flex items-center gap-2 cursor-pointer")
            input(
              type="radio"
              name="status"
              value="inactive"
              checked=(room.PHONG_TRANGTHAI === "inactive")
            )
            span Dừng hoạt động

      div
        label(class="block text-sm font-semibold text-n-700 mb-1" for="description")
          | Mô tả phòng
        textarea(
          id="description"
          name="description"
          rows="4"
          class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-p-500"
          placeholder="Nhập mô tả phòng..."
        )= room.PHONG_MOTA || ""

      div(class="flex justify-end items-center gap-3 pt-4")
        a(
          href="/admin/rooms"
          class="px-5 py-2 bg-n-200 hover:bg-n-300 text-n-800 rounded-lg font-semibold transition-all no-underline text-center"
        ) Hủy
        button(
          type="submit"
          class="px-5 py-2 btn-2 no-underline cursor-pointer text-center"
        ) Cập nhật