extends ../../layout/default.pug

block main
    section(class="py-12")
        .container(class="mx-auto px-4")
            div(class="text-center mb-10")
                h1(class="font-inter text-n-800 font-bold text-4xl mb-2") Danh Sách Dịch Vụ PetCare
                p(class="text-n-500 text-base") Các gói chăm sóc sức khỏe và làm đẹp toàn diện cho thú cưng của bạn

            div(class="grid grid-cols-1 md:grid-cols-3 gap-6")
                each item in services
                    div(class="border border-n-200 rounded-2xl bg-white overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-xl flex flex-col justify-between")
                        div
                            img(
                                src=item.thumbnail ? item.thumbnail : "/img/thumbnail.jpg" 
                                alt=item.title 
                                class="h-[230px] w-full object-cover"
                            )
                        div(class="flex flex-col gap-3 p-5")
                            h3(class="font-inter text-n-800 text-xl font-bold")= item.title
                            div(class="flex items-center gap-2 text-n-500 text-sm") 
                                i(class="fa-solid fa-paw text-p-500")
                                span Dành cho Chó & Mèo
                            div(class="flex items-center gap-2 text-n-500 text-sm") 
                                i(class="fa-solid fa-location-dot text-p-500") 
                                span Chi nhánh Ninh Kiều, Cần Thơ
                            div(class="flex items-center justify-between pt-2 border-t border-n-100")  
                                h2(class="font-inter text-p-700 text-lg font-bold") #{item.price} VND
                                a(href=`/services/detail/${item.id}` class="text-n-500 hover:text-p-500 font-medium text-sm underline") Chi tiết
                            
                            div(class="flex justify-center mt-2")
                                div(class="inline-flex bg-p-700 p-1 rounded-full")
                                    a(href=`/services/booking/${item.id}` class="inline-flex items-center justify-center bg-p-500 text-white px-6 py-2 rounded-full font-semibold text-sm hover:bg-p-700 transition-all duration-200") Đặt Lịch Ngay