extends ../../layout/default.pug

block main
    div(style="padding-top: 60px; padding-bottom: 60px;")
        section#rooms-hero.mb-12
            .container
                .text-center.max-w-2xl.mx-auto.flex.flex-col.gap-3
                    p(class="text-p-500 text-sm uppercase font-bold tracking-wider") PetCare &bull; Hệ Thống Phòng Lưu Trú

        section#rooms-list
            .container
                if errorMessage
                    div(class="mb-4 rounded-lg bg-red-100 p-4 text-red-800")= errorMessage

                if successMessage
                    div(class="mb-4 rounded-lg bg-green-100 p-4 text-green-800")= successMessage

                div(class="grid grid-cols-1 md:grid-cols-3 gap-8")
                    if rooms && rooms.length > 0
                        each room in rooms
                            div(class="border border-n-200 rounded-2xl bg-white overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-n-200 flex flex-col")
                                div
                                    img(
                                        src=room.image || "/image/thumbnail.jpg"
                                        alt=room.name
                                        class="h-[250px] w-full object-cover rounded-t-2xl"
                                    )

                                div(class="flex flex-col gap-3 p-6 flex-1 justify-between")
                                    div(class="flex flex-col gap-3")
                                        h3(class="font-inter text-n-800 text-xl font-bold") #{room.name}

                                        div(class="flex items-center gap-2 text-n-500")
                                            i(class="fa-solid fa-paw")
                                            span Sức chứa: #{room.capacity} thú cưng

                                        div(class="flex items-center gap-2 text-n-500")
                                            i(class="fa-solid fa-money-bill-wave")
                                            span #{room.price}đ / ngày

                                        if room.description
                                            p(class="text-n-500")= room.description

                                    div(class="pt-4 border-t border-n-100")
                                        div(class="flex items-center justify-between mb-3")
                                            a(
                                                href=`/booking/rooms/${room.id}`
                                                class="btn-2 w-full rounded-full no-underline text-center"
                                            ) Đặt phòng
                    else
                        .col-span-3.text-center.py-12.text-n-500 Hiện chưa có phòng lưu trú đang hoạt động.