extends ../../layout/default.pug

block main
  main(class="mx-auto my-16 max-w-xl px-4")
    div(class="rounded-2xl bg-white p-8 text-center shadow")
      if result === "success"
        h1(class="text-2xl font-bold text-[#4A3525]") Đã quay lại từ SePay
        p(class="mt-3 text-gray-600")
          | Hệ thống đang chờ IPN xác nhận giao dịch. Trạng thái thanh toán chỉ đổi sau khi server nhận xác nhận từ SePay.
      else if result === "cancel"
        h1(class="text-2xl font-bold text-[#4A3525]") Bạn đã hủy thanh toán
        p(class="mt-3 text-gray-600") Lịch vẫn được giữ. Bạn có thể thử lại trong lịch đặt.
      else
        h1(class="text-2xl font-bold text-[#4A3525]") Thanh toán chưa hoàn tất
        p(class="mt-3 text-gray-600") Kiểm tra lại lịch đặt hoặc thử thanh toán sau.
      a(
        href="/booking/history"
        class="mt-6 inline-block rounded-xl bg-[#4A3525] px-5 py-3 font-semibold text-white no-underline"
      ) Xem lịch đặt