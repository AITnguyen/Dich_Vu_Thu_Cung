extends ../../layout/default.pug

block main
  main(class="mx-auto my-10 max-w-2xl px-4")
    div(class="rounded-2xl bg-white p-6 shadow")
      h1(class="text-2xl font-bold text-[#4A3525]") Đặt phòng lưu trú
      p(class="mt-2 text-gray-700")= room.PHONG_TEN
      p(class="mt-1 text-gray-600") Sức chứa: #{room.PHONG_SL} thú cưng
      p(class="mt-1 font-semibold text-[#4A3525]") #{price}đ / ngày

      if errorMessage
        div(class="mt-5 rounded-lg bg-red-100 p-3 text-red-800")= errorMessage

      if !pets.length
        div(class="mt-5 rounded-lg bg-amber-100 p-4 text-amber-900")
          | Tài khoản chưa có thú cưng đã đăng ký. Hãy thêm thú cưng trước khi đặt phòng.
      else
        form(
          action=`/booking/rooms/${room.PHONG_ID}`
          method="POST"
          class="mt-6 space-y-5"
        )
          div
            label(class="mb-1 block font-semibold" for="petId") Thú cưng
            select(
              id="petId"
              name="petId"
              required
              class="w-full rounded-lg border p-3"
            )
              option(value="") Chọn thú cưng
              each pet in pets
                option(value=pet.id)= pet.name

          div
            label(class="mb-1 block font-semibold" for="checkIn") Ngày nhận phòng
            input(
              id="checkIn"
              type="date"
              name="checkIn"
              min=today
              required
              class="w-full rounded-lg border p-3"
            )

          div
            label(class="mb-1 block font-semibold" for="days") Số ngày lưu trú
            input(
              id="days"
              type="number"
              name="days"
              min="1"
              step="1"
              value="1"
              required
              class="w-full rounded-lg border p-3"
            )

          div
            p(class="mb-2 font-semibold") Cách thanh toán
            label(class="mr-5 inline-flex items-center gap-2")
              input(type="radio" name="paymentMethod" value="TienMat" required)
              span Thanh toán trực tiếp
            label(class="inline-flex items-center gap-2")
              input(type="radio" name="paymentMethod" value="SePay" required)
              span Thanh toán online qua SePay

          p(class="text-sm text-gray-600")
            | Tổng tiền được tính theo giá mỗi ngày nhân với số ngày. Lịch chờ admin xác nhận trước khi thanh toán online.

          button(
            type="submit"
            class="w-full rounded-xl bg-[#4A3525] p-3 font-semibold text-white"
          ) Gửi yêu cầu đặt phòng