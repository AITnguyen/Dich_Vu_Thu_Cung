extends ../../layout/default.pug

block main
  main(class="mx-auto my-10 max-w-2xl px-4")
    div(class="rounded-2xl bg-white p-6 shadow")
      h1(class="text-2xl font-bold text-[#4A3525]") Đặt lịch dịch vụ
      p(class="mt-2 text-gray-700")= service.DV_TEN
      p(class="mt-1 font-semibold text-[#4A3525]") #{price}đ / lượt

      if errorMessage
        div(class="mt-5 rounded-lg bg-red-100 p-3 text-red-800")= errorMessage

      if !pets.length
        div(class="mt-5 rounded-lg bg-amber-100 p-4 text-amber-900")
          | Tài khoản chưa có thú cưng đã đăng ký. Hãy thêm thú cưng trước khi đặt lịch.
      else
        form(
          action=`/booking/services/${service.DV_ID}`
          method="POST"
          class="mt-6 space-y-5"
        )
          div
            label(class="mb-1 block font-semibold" for="petId") Thú cưng
            select(
              id="petId"
              name="petId"
              required
              class="w-full rounded-lg border p-3"
            )
              option(value="") Chọn thú cưng
              each pet in pets
                option(value=pet.id)= pet.name

          div
            label(class="mb-1 block font-semibold" for="date") Ngày hẹn
            input(
              id="date"
              type="date"
              name="date"
              min=today
              required
              class="w-full rounded-lg border p-3"
            )

          div
            label(class="mb-1 block font-semibold" for="time") Giờ hẹn
            select(
              id="time"
              name="time"
              required
              class="w-full rounded-lg border p-3"
            )
              option(value="") Chọn giờ
              each time in timeSlots
                option(value=time)= time

          div
            p(class="mb-2 font-semibold") Cách thanh toán
            label(class="mr-5 inline-flex items-center gap-2")
              input(type="radio" name="paymentMethod" value="TienMat" required)
              span Thanh toán trực tiếp
            label(class="inline-flex items-center gap-2")
              input(type="radio" name="paymentMethod" value="SePay" required)
              span Thanh toán online qua SePay

          p(class="text-sm text-gray-600")
            | Lịch sẽ chờ quản trị viên xác nhận. Nếu chọn SePay, bạn thanh toán sau khi lịch được duyệt.

          button(
            type="submit"
            class="w-full rounded-xl bg-[#4A3525] p-3 font-semibold text-white"
          ) Gửi yêu cầu đặt lịch