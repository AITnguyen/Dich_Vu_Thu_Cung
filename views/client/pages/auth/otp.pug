extends ../../layout/auth.pug

block main
  div(class="min-h-screen flex items-center justify-center bg-gray-100 p-4")
    div(class="max-w-lg w-full bg-white rounded-2xl shadow-xl p-8")
      h1(class="text-2xl font-bold text-gray-900 mb-2") Xác thực email
      p(class="text-sm text-gray-600 mb-6") Mã xác thực đã được gửi đến #{email}. Mã hết hạn sau 5 phút.

      if errorMessage
        div(class="mb-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700" role="alert")= errorMessage

      form(action="/auth/otp" method="POST" class="flex flex-col gap-4")
        label(for="code" class="text-sm font-semibold text-gray-700") Mã OTP 6 số
        input(type="text" id="code" name="code" required minlength="6" maxlength="6" inputmode="numeric" autocomplete="one-time-code" class="w-full px-4 py-3 rounded-xl border border-gray-300 tracking-[0.4em] text-center text-xl")
        button(type="submit" class="w-full py-3 bg-[#4A3525] text-white font-bold rounded-xl cursor-pointer") XÁC THỰC VÀ TẠO TÀI KHOẢN

      a(href="/auth/signup" class="block mt-4 text-center text-sm text-amber-800 hover:underline") Quay lại đăng ký