extends ../../layout/auth.pug

block main
  - const authPath = isAdmin ? "/admin/auth" : "/auth"
  div(class="min-h-screen flex items-center justify-center bg-gray-100 p-4")
    div(class="max-w-lg w-full bg-white rounded-2xl shadow-xl p-8")
      h1(class="text-2xl font-bold text-gray-900 mb-2") Quên mật khẩu
      p(class="text-sm text-gray-600 mb-6") Nhập email tài khoản. Nếu tài khoản hợp lệ, PetCare sẽ gửi mã xác thực.

      if errorMessage
        div(class="mb-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700" role="alert")= errorMessage

      form(action=authPath + "/forgot-password" method="POST" class="flex flex-col gap-4")
        label(for="email" class="text-sm font-semibold text-gray-700") Email
        input(type="email" id="email" name="email" required autocomplete="email" class="w-full px-4 py-3 rounded-xl border border-gray-300")
        button(type="submit" class="w-full py-3 bg-[#4A3525] text-white font-bold rounded-xl cursor-pointer") GỬI MÃ KHÔI PHỤC

      a(href=authPath + "/signin" class="block mt-4 text-center text-sm text-amber-800 hover:underline") Quay lại đăng nhập