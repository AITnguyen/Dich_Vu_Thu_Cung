extends ../../layout/default.pug

block main
    .py-16.flex.items-center.justify-center
        .container.max-w-md.mx-auto.px-4
            .bg-white.border.border-n-200.rounded-2xl.shadow-xl.p-8.flex.flex-col.gap-6
                .text-center.flex.flex-col.gap-2
                    h1(class="font-lobster text-4xl text-n-800") 
                        span(class="text-p-500") Đăng ký 
                        span(class="text-n-800") Tài khoản
                    p(class="text-n-500 text-sm") Tạo tài khoản mới để trải nghiệm dịch vụ.

                form(action="/auth/signup", method="POST" class="flex flex-col gap-4")
                    .flex.flex-col.gap-1.5
                        label(for="fullName" class="text-xs font-semibold text-n-800 uppercase tracking-wider") Họ và tên
                        input(
                            type="text" 
                            id="fullName" 
                            name="fullName" 
                            required 
                            placeholder="Nhập họ và tên..."
                            class="px-4 py-2.5 rounded-xl border border-n-200 text-n-800 text-sm focus:outline-none focus:border-p-500 transition-colors"
                        )

                    .flex.flex-col.gap-1.5
                        label(for="email" class="text-xs font-semibold text-n-800 uppercase tracking-wider") Email hoặc Số điện thoại
                        input(
                            type="text" 
                            id="email" 
                            name="email" 
                            required 
                            placeholder="Nhập email hoặc số điện thoại..."
                            class="px-4 py-2.5 rounded-xl border border-n-200 text-n-800 text-sm focus:outline-none focus:border-p-500 transition-colors"
                        )

                    .flex.flex-col.gap-1.5
                        label(for="password" class="text-xs font-semibold text-n-800 uppercase tracking-wider") Mật khẩu
                        input(
                            type="password" 
                            id="password" 
                            name="password" 
                            required 
                            placeholder="••••••••"
                            class="px-4 py-2.5 rounded-xl border border-n-200 text-n-800 text-sm focus:outline-none focus:border-p-500 transition-colors"
                        )

                    button(type="submit" class="mt-2 w-full py-3 bg-p-500 text-white font-semibold rounded-xl hover:bg-p-700 transition-colors shadow-md cursor-pointer")
                        | Đăng Ký

                .text-center.pt-2.border-t.border-n-100
                    p(class="text-xs text-n-500") Đã có tài khoản? 
                        a(class="text-p-500 font-semibold no-underline hover:underline" href="/auth/signin") Đăng nhập ngay