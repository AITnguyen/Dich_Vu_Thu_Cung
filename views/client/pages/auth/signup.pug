extends ../../layout/auth.pug

block main
  div(class="min-h-screen flex items-center justify-center bg-gray-100 p-4")
    div(class="max-w-4xl w-full bg-white rounded-2xl shadow-2xl overflow-hidden grid grid-cols-1 md:grid-cols-2")
      div(class="p-8 md:p-12 flex flex-col justify-center")
        h1(class="text-2xl font-bold text-gray-900 mb-2") Đăng ký tài khoản
        p(class="text-sm text-gray-500 mb-6") Tạo tài khoản để sử dụng các dịch vụ PetCare.

        if errorMessage
          div(class="mb-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700" role="alert")= errorMessage

        form(action="/auth/signup" method="POST" class="flex flex-col gap-4")
          div(class="flex flex-col gap-1.5")
            label(for="fullName" class="text-sm font-semibold text-gray-700") Họ và tên
            input(type="text" id="fullName" name="fullName" required maxlength="255" autocomplete="name" class="w-full px-4 py-3 rounded-xl border border-gray-300")

          div(class="flex flex-col gap-1.5")
            label(for="email" class="text-sm font-semibold text-gray-700") Email
            input(type="email" id="email" name="email" required autocomplete="email" class="w-full px-4 py-3 rounded-xl border border-gray-300")

          div(class="flex flex-col gap-1.5")
            label(for="sdt" class="text-sm font-semibold text-gray-700") Số điện thoại
            input(type="tel" id="sdt" name="sdt" autocomplete="tel" class="w-full px-4 py-3 rounded-xl border border-gray-300")

          div(class="flex flex-col gap-1.5")
            label(for="password" class="text-sm font-semibold text-gray-700") Mật khẩu
            input(type="password" id="password" name="password" required minlength="8" autocomplete="new-password" class="w-full px-4 py-3 rounded-xl border border-gray-300")

          div(class="flex flex-col gap-1.5")
            label(for="confirmPassword" class="text-sm font-semibold text-gray-700") Nhập lại mật khẩu
            input(type="password" id="confirmPassword" name="confirmPassword" required minlength="8" autocomplete="new-password" class="w-full px-4 py-3 rounded-xl border border-gray-300")

          button(type="submit" class="mt-2 w-full py-3 bg-[#4A3525] text-white font-bold rounded-xl hover:bg-[#38271a] cursor-pointer") GỬI MÃ XÁC THỰC

        p(class="text-sm text-gray-600 mt-5") Đã có tài khoản?
          a(href="/auth/signin" class="ml-1 text-amber-800 font-semibold hover:underline") Đăng nhập

      div(class="bg-[#4A3525] p-8 md:p-12 flex flex-col justify-center text-white")
        span(class="text-2xl font-extrabold mb-6") PetCare
        h2(class="text-3xl font-bold leading-tight mb-4") Đồng hành cùng sức khỏe thú cưng.
        p(class="text-amber-100/80 text-sm leading-relaxed") Xác thực email để tạo tài khoản và lưu thông tin chăm sóc cho bé cưng.