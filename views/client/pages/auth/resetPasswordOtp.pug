extends ../../layout/auth.pug

block main
  - const authPath = isAdmin ? "/admin/auth" : "/auth"
  div(class="min-h-screen flex items-center justify-center bg-gray-100 p-4")
    div(class="max-w-lg w-full bg-white rounded-2xl shadow-xl p-8")
      h1(class="text-2xl font-bold text-gray-900 mb-2") Đặt lại mật khẩu
      if successMessage
        div(class="mb-4 rounded-lg border border-green-200 bg-green-50 p-3 text-sm text-green-700" role="status")= successMessage
      if errorMessage
        div(class="mb-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700" role="alert")= errorMessage

      form(action=authPath + "/reset-password" method="POST" class="flex flex-col gap-4")
        div(class="flex flex-col gap-1.5")
          label(for="code" class="text-sm font-semibold text-gray-700") Mã OTP
          input(type="text" id="code" name="code" required minlength="