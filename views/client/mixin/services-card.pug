mixin serviceCard(image, title, type, location, price, detailUrl, bookingUrl)
  div(class="border border-n-200 bg-white rounded-2xl transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl overflow-hidden")
    div
      img(src=image, alt=title class="h-[230px] w-full object-cover") 
    div(class="flex flex-col gap-3 p-5")
      h3(class="font-inter text-n-800 text-xl font-bold") #{title}
      div(class="flex items-center gap-2 text-n-500 text-sm") 
        i(class="fa-solid fa-paw text-p-500")
        span #{type}
      div(class="flex items-center gap-2 text-n-500 text-sm") 
        i(class="fa-solid fa-location-dot text-p-500") 
        span #{location}
      div(class="flex items-center justify-between pt-2 border-t border-n-100")  
        h2(class="font-inter text-p-700 text-lg font-bold") #{price}
        a(href=detailUrl class="text-n-500 hover:text-p-500 font-medium text-sm underline") Chi tiết
      div(class="flex items-center justify-center mt-2") 
        a(href=bookingUrl class="bg-p-500 hover:bg-p-700 text-white font-semibold w-full text-center py-2.5 rounded-full shadow-sm hover:shadow transition-all duration-200 flex items-center justify-center gap-2 text-sm")
          i(class="fa-regular fa-calendar-days")
          span Đặt Lịch Ngay